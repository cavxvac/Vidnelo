<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vidnelo" Width="1160" Height="860" MinWidth="730" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="LanguageMenu" TargetType="ContextMenu">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="6">
          <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LanguageMenuItem" TargetType="MenuItem">
      <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6" Padding="8,5" MinHeight="30" Margin="0,1">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedMark" Text="✓" Foreground="{DynamicResource Accent}" Visibility="Hidden" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="Canvas" Color="#F3F5FA"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Input" Color="#FAFBFD"/>
    <SolidColorBrush x:Key="Text" Color="#182438"/>
    <SolidColorBrush x:Key="Secondary" Color="#5C6A80"/>
    <SolidColorBrush x:Key="Line" Color="#DFE5EE"/>
    <SolidColorBrush x:Key="Accent" Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EDF5FF"/>
    <SolidColorBrush x:Key="Green" Color="#147D53"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#E6F5ED"/>
    <SolidColorBrush x:Key="Red" Color="#B83939"/>
    <SolidColorBrush x:Key="RedSoft" Color="#FCECEC"/>
    <Geometry x:Key="DownloadGeometry">M12,3 L12,15 M6,9 L12,15 L18,9 M4,16 L4,21 L20,21 L20,16</Geometry>
    <Geometry x:Key="ClipboardGeometry">M8,5 L5,5 Q3,5 3,7 L3,20 Q3,22 5,22 L19,22 Q21,22 21,20 L21,7 Q21,5 19,5 L16,5 M8,3 L16,3 L16,7 L8,7 Z M8,12 L16,12 M8,16 L14,16</Geometry>
    <Geometry x:Key="FolderGeometry">M3,6 Q3,4 5,4 L10,4 L12,7 L20,7 Q22,7 22,9 L22,19 Q22,21 20,21 L4,21 Q2,21 2,19 L2,8 Q2,6 3,6 Z</Geometry>
    <Geometry x:Key="VideoGeometry">M4,5 L16,5 Q18,5 18,7 L18,17 Q18,19 16,19 L4,19 Q2,19 2,17 L2,7 Q2,5 4,5 Z M18,10 L23,7 L23,17 L18,14</Geometry>
    <Geometry x:Key="MusicGeometry">M9,17 L9,5 L21,2 L21,15 M9,8 L21,5 M9,17 C9,21 2,23 2,19 C2,16 9,15 9,17 M21,15 C21,19 14,21 14,17 C14,14 21,13 21,15</Geometry>
    <Geometry x:Key="RefreshGeometry">M20,9 A8,8 0 0 0 6,5 L3,8 M3,3 L3,8 L8,8 M4,15 A8,8 0 0 0 18,19 L21,16 M16,16 L21,16 L21,21</Geometry>
    <Geometry x:Key="MoonGeometry">M19,16 A9,9 0 1 1 9,3 A8,8 0 0 0 19,16 Z</Geometry>
    <Geometry x:Key="LinkGeometry">M10,14 L14,10 M9,16 L7,18 A4,4 0 0 1 1,12 L6,7 A4,4 0 0 1 12,7 M15,8 L17,6 A4,4 0 0 1 23,12 L18,17 A4,4 0 0 1 12,17</Geometry>
    <Geometry x:Key="CheckGeometry">M4,12 L9,17 L20,6</Geometry>
    <Style x:Key="Glyph" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
      <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Stretch" Value="Uniform"/><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
    </Style>
    <Style x:Key="KeyboardButtonFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="12" Margin="-3" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardButtonFocus}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/>
      <Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
            <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="Hover" Background="#708CA8" Opacity="0" CornerRadius="12" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>

          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.10" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
            <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="__FAST__"/><DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="__FAST__"/><DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>

            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonRoot" Property="Opacity" Value="0.48"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="SelectionBrush" Value="#83BAF0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FormatTile" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid>
          <Border x:Name="Tile" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"/>
          <ContentPresenter Margin="18,17,38,17"/>
          <Ellipse x:Name="DotRing" Width="16" Height="16" Stroke="{DynamicResource Secondary}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"/>
          <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0" Opacity="0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="DotRing" Property="Stroke" Value="{DynamicResource Accent}"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderThickness" Value="2"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Padding" Value="28"/></Style>
    <Style TargetType="Expander">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Height="32" HorizontalAlignment="Left" Cursor="Hand" Foreground="{TemplateBinding Foreground}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Padding="2,6" Background="Transparent"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M1,1 L5,5 L9,1" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="10" Height="6" Margin="0,0,10,0" VerticalAlignment="Center"/><ContentPresenter/></StackPanel></Border></ControlTemplate></ToggleButton.Template>
            <ContentPresenter Content="{TemplateBinding Header}"/>
          </ToggleButton>
          <ContentPresenter x:Name="DetailsContent" Visibility="Collapsed" Opacity="0"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DetailsContent" Property="Visibility" Value="Visible"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="DetailsContent" Storyboard.TargetProperty="Opacity" To="1" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="DetailsContent" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="10,6"/></Style>
    <SolidColorBrush x:Key="Quiet" Color="#8896AA"/>
    <SolidColorBrush x:Key="Track" Color="#DFE9F5"/>
    <LinearGradientBrush x:Key="StatusSurface" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F6FAFF" Offset="0"/><GradientStop Color="#EEF5FD" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0767D8" Offset="0"/><GradientStop Color="#1D9FED" Offset="1"/></LinearGradientBrush>
    <Geometry x:Key="SunGeometry">M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 M12,1 L12,3 M12,21 L12,23 M1,12 L3,12 M21,12 L23,12 M4,4 L6,6 M18,18 L20,20 M4,20 L6,18 M18,6 L20,4</Geometry>
    <Style x:Key="FormatTile2" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Grid Height="80"><Border x:Name="Tile" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"/>
          <Border x:Name="Selection" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="14" Opacity="0"/>
          <ContentPresenter Margin="15,0,34,0" VerticalAlignment="Center"/>
          <Ellipse x:Name="Ring" Width="14" Height="14" Stroke="{DynamicResource Quiet}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"/>
          <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0" Opacity="0"/>
          <Border x:Name="TileFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="12" Margin="-3" Visibility="Collapsed"/>
        </Grid><ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="1" Duration="__FAST__"/><DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Selection" Storyboard.TargetProperty="Opacity" To="0" Duration="__FAST__"/><DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="__FAST__"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TileFocus" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="FontSize" Value="13"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"><Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Secondary}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Border x:Name="QualityFocus" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0"><ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="QualityFocus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="{DynamicResource Quiet}" CornerRadius="4" Opacity="0.4" Margin="1,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Canvas}" Focusable="False">
    <Grid x:Name="Page" Margin="36,24,36,22" MaxWidth="1280">
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="108"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="Vidnelo">
          <Image x:Name="BrandIcon" Width="42" Height="42" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Rectangle x:Name="BrandWordmark" Width="120" Height="26.38" Fill="{DynamicResource Text}" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Vidnelo"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="3">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="UpdateButton" ToolTip="Aktualizacje" Background="Transparent" BorderThickness="0" Height="40" VerticalAlignment="Center" Padding="12,0"><Grid Height="20"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Path Style="{StaticResource Glyph}" Data="{StaticResource RefreshGeometry}" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Aktualizuj" FontSize="12" VerticalAlignment="Center" Padding="0,0,0,1"/></Grid></Button>
            <Border Width="1" Background="{DynamicResource Line}" Margin="6,10"/>
            <Button x:Name="ThemeButton" Padding="12,7" Background="Transparent" BorderThickness="0" ToolTip="Zmień motyw" AutomationProperties.Name="Zmień motyw"><Path x:Name="ThemeGlyph" Style="{StaticResource Glyph}" Data="{StaticResource MoonGeometry}" Width="16" Height="16"/></Button>
            <Button x:Name="LanguageButton" Padding="12,7" Background="Transparent" BorderThickness="0" ToolTip="Zmień język" AutomationProperties.Name="Zmień język"><Path Style="{StaticResource Glyph}" Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M2,12 L22,12 M12,2 C5,8 5,16 12,22 M12,2 C19,8 19,16 12,22" Width="16" Height="16"/></Button>
            <Button x:Name="AboutButton" Padding="12,7" Background="Transparent" BorderThickness="0" ToolTip="O aplikacji i twórcach" AutomationProperties.Name="O aplikacji i twórcach"><Path Style="{StaticResource Glyph}" Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,11 L12,17 M12,7 L12,7.2" Width="16" Height="16"/></Button>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="1"><StackPanel VerticalAlignment="Center">
        <TextBlock Text="Pobierz z linku" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="36" FontWeight="SemiBold"/>
        <TextBlock Text="Ulubione filmy i dźwięk. Zawsze pod ręką." Foreground="{DynamicResource Secondary}" Margin="0,5,0,0" FontSize="14"/>
      </StackPanel></Grid>
      <Grid x:Name="Workspace" Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="FormCard" Style="{StaticResource Card}">
          <Border.Effect><DropShadowEffect Color="#132843" BlurRadius="24" ShadowDepth="4" Opacity="0.04"/></Border.Effect>
          <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
          <StackPanel>
            <TextBlock Text="Link do filmu" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border x:Name="UrlBorder" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Background="{DynamicResource Input}" Height="58">
              <Grid Margin="16,5,5,5"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Path Data="{StaticResource LinkGeometry}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Accent}" Width="18" Height="18" HorizontalAlignment="Left"/>
                <TextBlock x:Name="UrlHint" Grid.Column="1" Text="Wklej link lub użyj Ctrl+V" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Quiet}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="UrlInput" Grid.Column="1" FontSize="13" AutomationProperties.Name="Link do filmu"/>
                <Button x:Name="PasteButton" Grid.Column="3" Padding="13,8" Background="{DynamicResource Surface}" BorderThickness="0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource ClipboardGeometry}" Width="16" Height="16"/><TextBlock Text="Wklej" Margin="7,0,0,0"/></StackPanel></Button>
              </Grid>
            </Border>
            <Grid x:Name="FormatGrid" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <RadioButton x:Name="VideoOption" Style="{StaticResource FormatTile2}" GroupName="Format" IsChecked="True" AutomationProperties.Name="Film"><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0"><Path Data="{StaticResource VideoGeometry}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Accent}" Width="20" Height="20"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Film" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="VideoFormatHint" Text="MP4 · obraz i dźwięk" FontSize="11" Foreground="{DynamicResource Secondary}" Margin="0,4,0,0"/></StackPanel></StackPanel></RadioButton>
              <RadioButton x:Name="AudioOption" Grid.Column="2" Style="{StaticResource FormatTile2}" GroupName="Format" AutomationProperties.Name="Dźwięk"><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0"><Path Data="{StaticResource MusicGeometry}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Accent}" Width="20" Height="20"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Dźwięk" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="AudioFormatHint" Text="MP3 · tylko audio" FontSize="11" Foreground="{DynamicResource Secondary}" Margin="0,4,0,0"/></StackPanel></StackPanel></RadioButton>
            </Grid>
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Format" FontSize="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/><ComboBox x:Name="FileFormatSelect" Grid.Column="2" Height="40" AutomationProperties.Name="Format pliku"/>
              <TextBlock Grid.Column="4" Text="Jakość" FontSize="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/><ComboBox x:Name="QualitySelect" Grid.Column="6" Height="40" AutomationProperties.Name="Jakość pobierania"/>
            </Grid>
            <TextBlock Text="Zapisz w folderze" FontWeight="SemiBold" Margin="0,24,0,10"/>
            <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,0" Height="44"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Style="{StaticResource Glyph}" Data="{StaticResource FolderGeometry}" Stroke="{DynamicResource Secondary}" HorizontalAlignment="Left" Width="17" Height="17"/><TextBlock x:Name="FolderText" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/></Grid></Border>
            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="BrowseButton" Content="Zmień folder" Height="40" Padding="10,8" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Secondary}"/>
              <Button x:Name="OpenButton" Grid.Column="2" Content="Otwórz folder" Height="40" Padding="10,8" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Secondary}"/>
            </Grid>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,18"/>
            <Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto" MinWidth="94"/></Grid.ColumnDefinitions>
              <Button x:Name="DownloadButton" IsDefault="True" Background="{DynamicResource ButtonGradient}" Foreground="White" BorderThickness="0"><Button.Effect><DropShadowEffect Color="#126BE3" BlurRadius="16" ShadowDepth="4" Opacity="0.15"/></Button.Effect><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource DownloadGeometry}"/><TextBlock x:Name="DownloadLabel" Text="Pobierz film" Margin="10,0,0,0" FontSize="14"/></StackPanel></Button>
              <Button x:Name="CancelButton" Grid.Column="2" Content="Anuluj" IsEnabled="False" Padding="12,8" Background="Transparent"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border x:Name="StatusCard" Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource StatusSurface}" BorderBrush="#263A52" Padding="0">
          <Border.Resources>
            <SolidColorBrush x:Key="Text" Color="#F4F8FF"/><SolidColorBrush x:Key="Secondary" Color="#AEBCD0"/>
            <SolidColorBrush x:Key="Quiet" Color="#8097B3"/><SolidColorBrush x:Key="Line" Color="#2A3E56"/>
            <SolidColorBrush x:Key="Track" Color="#2A3E56"/><SolidColorBrush x:Key="Accent" Color="#81C6FF"/>
            <SolidColorBrush x:Key="AccentSoft" Color="#243E59"/><SolidColorBrush x:Key="Green" Color="#064C30"/>
            <SolidColorBrush x:Key="GreenSoft" Color="#3CE693"/><SolidColorBrush x:Key="Red" Color="#FFB6B6"/>
            <SolidColorBrush x:Key="RedSoft" Color="#513342"/>
          </Border.Resources>
          <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
          <Grid>
            <Grid Margin="28" TextBlock.Foreground="{DynamicResource Text}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="STATUS POBIERANIA" Foreground="{DynamicResource Secondary}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="StatePill" Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="10,5"><TextBlock x:Name="StateText" Text="Gotowy" Foreground="{DynamicResource Accent}" FontSize="11"/></Border>
              </Grid>
              <Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="StatusBadge" Width="38" Height="38" Margin="0,2,12,0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin=".5,.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform><Path x:Name="StatusGlyph" Data="{StaticResource CheckGeometry}" Style="{StaticResource Glyph}" Stroke="{DynamicResource Green}" Width="19" Height="19" Visibility="Collapsed"/></Border>
                <StackPanel Grid.Column="1"><TextBlock x:Name="StatusTitle" Text="Wszystko gotowe" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="StatusDetail" MinHeight="36" MaxHeight="54" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="Dodaj link, a resztą zajmiemy się tutaj." Foreground="{DynamicResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
              </Grid>
              <Grid Grid.Row="3" Margin="0,4,0,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="PercentText" Text="—" FontSize="56" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" Foreground="{DynamicResource Text}"/>
                <TextBlock x:Name="ProgressCaption" Grid.Row="1" Text="Czekam na link" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,2,0,0"/>
              </Grid>
              <Grid x:Name="ProgressTrack" Grid.Row="4" Height="10" ClipToBounds="True"><Grid.Clip><RectangleGeometry RadiusX="5" RadiusY="5" Rect="0,0,0,10"/></Grid.Clip>
                <Border Background="{DynamicResource Track}" CornerRadius="5"/>
                <Border x:Name="ProgressFill" Background="{DynamicResource AccentGradient}" CornerRadius="5"><Border.Clip><RectangleGeometry Rect="0,0,0,10" RadiusX="5" RadiusY="5"/></Border.Clip></Border>
                <Border x:Name="Marquee" Width="90" HorizontalAlignment="Left" Background="{DynamicResource AccentGradient}" CornerRadius="5" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform X="-90"/></Border.RenderTransform></Border>
                <Border x:Name="ProgressSheen" Width="64" HorizontalAlignment="Left" Visibility="Collapsed" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#60FFFFFF" Offset=".5"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background><Border.RenderTransform><TranslateTransform X="-64"/></Border.RenderTransform></Border>
              </Grid>
              <Grid Grid.Row="5" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Prędkość" FontSize="11" Foreground="{DynamicResource Secondary}"/><TextBlock x:Name="SpeedText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Pozostały czas" FontSize="11" Foreground="{DynamicResource Secondary}"/><TextBlock x:Name="EtaText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
              </Grid>
              <Grid Grid.Row="6" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Rozmiar" FontSize="11" Foreground="{DynamicResource Secondary}"/><TextBlock x:Name="SizeText" Grid.Column="1" Text="—" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource Secondary}"/></Grid>
              <StackPanel Grid.Row="7" Margin="0,18,0,0"><Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,18"/>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="Step1Badge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Track}" HorizontalAlignment="Left"><Path x:Name="Step1Mark" Height="9" Fill="{DynamicResource Secondary}" Stretch="Fill" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False"/></Border><TextBlock x:Name="Step1Text" Grid.Column="1" Text="Połączenie z serwisem" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/><TextBlock x:Name="Step1State" Grid.Column="2" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></Grid>
<Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="Step2Badge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Track}" HorizontalAlignment="Left"><Path x:Name="Step2Mark" Height="9" Fill="{DynamicResource Secondary}" Stretch="Fill" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False"/></Border><TextBlock x:Name="Step2Text" Grid.Column="1" Text="Pobieranie materiału" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/><TextBlock x:Name="Step2State" Grid.Column="2" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></Grid>
<Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="Step3Badge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Track}" HorizontalAlignment="Left"><Path x:Name="Step3Mark" Height="9" Fill="{DynamicResource Secondary}" Stretch="Fill" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False"/></Border><TextBlock x:Name="Step3Text" Grid.Column="1" Text="Zapis gotowego pliku" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/><TextBlock x:Name="Step3State" Grid.Column="2" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></Grid>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Expander x:Name="DetailsExpander" Grid.Row="3" Header="Szczegóły pobierania" Foreground="{DynamicResource Secondary}" Margin="0,12,0,0" FontSize="11"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,8,0,0"><TextBox x:Name="LogBox" Height="140" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" VerticalContentAlignment="Top" AutomationProperties.Name="Dziennik pobierania"/></Border></Expander>
      <Button x:Name="SupportedSitesButton" Grid.Row="3" Content="Obsługiwane witryny" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Secondary}" FontSize="11" FontWeight="Normal" Height="32" MinHeight="32" Margin="0,12,0,0" Padding="2,6" HorizontalAlignment="Right" VerticalAlignment="Top"/>
    </Grid>
  </ScrollViewer>
</Window>
