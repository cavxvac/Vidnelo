<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="O aplikacji · Vidnelo" Width="656" Height="770" MinWidth="480" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border Background="{DynamicResource Canvas}">
    <Grid Margin="32,28,32,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,26">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
          <Border Width="60" Height="60" CornerRadius="19" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,14,0">
            <Image x:Name="AboutIcon" Width="40" Height="40"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <Rectangle x:Name="AboutWordmark" Width="126" Height="27.7" Fill="{DynamicResource Text}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Secondary}" FontSize="11" Margin="0,7,0,0"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="13,8" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="160">
          <TextBlock Text="O aplikacji" Foreground="{DynamicResource Secondary}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22" Padding="24" Margin="0,0,0,16">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="TWÓRCA VIDNELO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap"/>
                <TextBlock Text="cavxvac" FontSize="32" FontWeight="SemiBold" Margin="0,7,0,5"/>
                <TextBlock Text="Autor aplikacji i interfejsu graficznego Vidnelo." Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" LineHeight="21"/>
                <TextBlock Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="24" FlowDirection="LeftToRight">
                  <Hyperlink NavigateUri="https://gerardbinder.com" Foreground="{DynamicResource Accent}" TextDecorations="None">gerardbinder.com</Hyperlink><Run Text="   ·   "/><Hyperlink NavigateUri="https://github.com/cavxvac" Foreground="{DynamicResource Accent}" TextDecorations="None">GitHub: cavxvac</Hyperlink>
                </TextBlock>
              </StackPanel>
              <Border Grid.Column="1" Width="44" Height="44" Background="{DynamicResource AccentSoft}" CornerRadius="15" VerticalAlignment="Top" Margin="16,0,0,0" IsHitTestVisible="False">
                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12,3 A4,4 0 1 0 12,11 A4,4 0 1 0 12,3 M4,21 L4,19 C4,12 20,12 20,19 L20,21"/>
              </Border>
            </Grid>
          </Border>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22" Padding="24">
            <StackPanel>
              <Border Background="{DynamicResource AccentSoft}" CornerRadius="14" Padding="15,12" Margin="-6,-6,-6,18">
                <TextBlock Text="Napędzane przez yt-dlp" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Text}"/>
              </Border>
              <TextBlock Text="Vidnelo to niezależny, wizualny klient yt-dlp. Ułatwia wklejanie linków, wybór jakości i uruchamianie pobierania." TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>
              <TextBlock Text="Rozpoznawanie witryn, wyszukiwanie dostępnych formatów i pobieranie materiałów realizuje yt-dlp, uruchamiane lokalnie na Twoim komputerze." TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" LineHeight="22"/>
              <TextBlock Text="Podziękowania dla twórców i społeczności yt-dlp, dzięki którym Vidnelo może działać." TextWrapping="Wrap" Margin="0,14,0,18" LineHeight="22"/>
              <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,14"/>
              <TextBlock TextWrapping="Wrap" LineHeight="29" FontWeight="SemiBold" FontSize="12">
                <Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp" Foreground="{DynamicResource Accent}" TextDecorations="None">Projekt yt-dlp</Hyperlink><Run Text="   ·   "/><Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp#installation" Foreground="{DynamicResource Accent}" TextDecorations="None">Instalacja i dokumentacja</Hyperlink><LineBreak/>
                <Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp/blob/master/CONTRIBUTORS" Foreground="{DynamicResource Accent}" TextDecorations="None">Współtwórcy</Hyperlink><Run Text="   ·   "/><Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp#licensing" Foreground="{DynamicResource Accent}" TextDecorations="None">Licencje yt-dlp</Hyperlink>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22" Padding="24" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Narzędzia pomocnicze" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" LineHeight="25" FontSize="12"><Hyperlink NavigateUri="https://ffmpeg.org/" Foreground="{DynamicResource Accent}" TextDecorations="None">FFmpeg / FFprobe</Hyperlink><Run Text=" — łączenie, konwersja i sprawdzanie plików."/><LineBreak/><Hyperlink NavigateUri="https://deno.com/" Foreground="{DynamicResource Accent}" TextDecorations="None">Deno</Hyperlink><Run Text=" — środowisko JavaScript wykorzystywane przez yt-dlp."/></TextBlock>
            </StackPanel>
          </Border>
          <TextBlock x:Name="LinkError" Foreground="{DynamicResource Red}" TextWrapping="Wrap" Visibility="Collapsed" Margin="4,16,4,0"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,20,0,0">
        <Button x:Name="CloseAboutButton" Content="Zamknij" IsCancel="True" HorizontalAlignment="Right" MinWidth="112" MinHeight="44" Padding="22,11"/>
      </Grid>
    </Grid>
  </Border>
</Window>
